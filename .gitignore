# Учётные данные. В этом проекте .env не используется НИКОГДА и не должен
# появиться: секреты Spotify и Cloudflare живут в секретах Pages, а не на
# диске. Строка стоит здесь страховкой — репозиторий публичный, и один
# `git add -A` по невнимательности опубликовал бы файл навсегда.
.env
.env.*
!.env.example
